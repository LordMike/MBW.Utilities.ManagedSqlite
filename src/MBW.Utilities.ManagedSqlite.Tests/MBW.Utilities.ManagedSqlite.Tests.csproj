<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One test run per build of the library: net8.0 gets its netstandard2.0 build, net9.0 and net10.0 their own.
         CI installs only the .NET 10 runtime, so every run rolls forward onto it. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Data\*" />
    <EmbeddedResource Include="Data\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.7.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" Version="2.5.0" />
    <!-- Test-only oracle: real SQLite builds the databases and dumps them for SqliteParity -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MBW.Utilities.ManagedSqlite\MBW.Utilities.ManagedSqlite.csproj" />
  </ItemGroup>

  <!-- Named, so the net8.0 run keeps testing the netstandard2.0 build whatever targets the library gains -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ProjectReference Update="..\MBW.Utilities.ManagedSqlite\MBW.Utilities.ManagedSqlite.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
