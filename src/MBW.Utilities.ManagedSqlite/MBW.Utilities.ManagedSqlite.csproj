<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- net9.0 brings System.Threading.Lock, net10.0 is the current LTS; netstandard2.0 covers everything else -->
    <TargetFrameworks>netstandard2.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <Description>SQLite3 library in managed C# that can read sqlite db files: the binary database, its tables and rows, and the table definitions from the schema's CREATE statements.</Description>
    <PackageTags>sqlite;sqlite3;database;db;reader;read-only;managed;parser;file-format</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Every public type and member needs an XML comment. Directory.Build.props and .editorconfig silence CS1591
         repo-wide; making it an error here overrides both for this project only. -->
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net9.0'))">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Span and BinaryPrimitives are part of .NET itself -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MBW.Utilities.ManagedSqlite.Tests" />
  </ItemGroup>

</Project>
